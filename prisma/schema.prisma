// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String?
  noHp      String?
  role      Role
  profilePhotoUrl String?
  position  String?
  lastLogin DateTime?
  patient   Patient? @relation(fields: [patientId], references: [id])
  patientId String?  @unique
  recordedAccidents Accident[] @relation("UserRecordedAccidents")
}

model Patient {
  id        String   @id @default(uuid())
  fullName  String
  address   String
  dob       DateTime
  medicalRecords MedicalRecord[]
  user      User?
  accidents Accident[] @relation("PatientAccidents")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalRecord {
  id        String   @id @default(cuid())
  penyakit  String
  obat      String
  dokter    String
  ruangan   String
  tanggal   DateTime
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Accident {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation("PatientAccidents", fields: [patientId], references: [id])
  tanggalKejadian   DateTime
  lokasi            String
  kronologi         String
  sudahDitangani    Boolean
  penanganan        String?
  kondisiPatient    String?
  hasilPengecekan   String?
  petugasPencatatId String
  petugasPencatat   User     @relation("UserRecordedAccidents", fields: [petugasPencatatId], references: [id])
  catatanTambahan   String?
  ditanganiOleh     String?
  createdAt         DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PATIENT
}

